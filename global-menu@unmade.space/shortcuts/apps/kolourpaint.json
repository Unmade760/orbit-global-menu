        },
        {
          "label": "Color Eraser",
          "shortcut": "o"
        },
        {
          "label": "Eraser",
          "shortcut": "a"
        },
        {
          "label": "Pen",
          "shortcut": "p"
        },
        {
          "label": "Spraycan",
          "shortcut": "y"
        },
        {
          "label": "Color Picker",
          "shortcut": "c"
        },
        {
          "label": "Flood Fill",
          "shortcut": "f"
        },
        {
          "label": "Zoom",
          "shortcut": "z"
        },
        {
          "label": "Curve",
          "shortcut": "v"
        },
        {
          "label": "Line",
          "shortcut": "l"
        },
        {
          "label": "Polygon",
          "shortcut": "g"
        },
        {
          "label": "Connected Lines",
          "shortcut": "n"
        },
        {
          "label": "Ellipse",
          "shortcut": "e"
        },
        {
          "label": "Rectangle",
          "shortcut": "r"
        },
        {
          "label": "Rounded Rectangle",
          "shortcut": "u"
        },
        {
          "label": "Selection (Elliptical)",
          "shortcut": "i"
        },
        {
          "label": "Selection (Free-Form)",
          "shortcut": "m"
        },
        {
          "label": "Selection (Rectangular)",
          "shortcut": "s"
        },
        {
          "label": "Text",
          "shortcut": "t"
        }
      ]
    },
    {
      "label": "Settings",
      "items": [
        {
          "label": "Full Screen Mode",
          "shortcut": "<Ctrl><Shift>F"
        },
        {
          "label": "Configure Keyboard Shortcuts…",
          "shortcut": "<Ctrl><Alt>comma"
        }
      ]
    }
  ]
}