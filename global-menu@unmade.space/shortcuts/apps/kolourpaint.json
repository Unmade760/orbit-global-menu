        {
          "label": "Autocrop",
          "shortcut": "<Ctrl>U"
        },
        {
          "separator": true
        },
        {
          "label": "Resize / Scale...",
          "shortcut": "<Ctrl>E"
        },
        {
          "label": "Flip (upside down)",
          "shortcut": "<Ctrl>F"
        },
        {
          "separator": true
        },
        {
          "label": "Rotate Left",
          "shortcut": "<Ctrl><Shift>Left"
        },
        {
          "label": "Rotate Right",
          "shortcut": "<Ctrl><Shift>Right"
        },
        {
          "label": "Rotate...",
          "shortcut": "<Ctrl>R"
        },
        {
          "separator": true
        },
        {
          "label": "Skew...",
          "shortcut": "<Ctrl>K"
        },
        {
          "separator": true
        },
        {
          "label": "More Effects...",
          "shortcut": "<Ctrl>M"
        },
        {
          "separator": true
        },
        {
          "label": "Invert Colors",
          "shortcut": "<Ctrl>I"
