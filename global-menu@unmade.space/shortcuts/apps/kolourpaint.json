{
  "format": 1,
  "app": "kolourpaint",
  "name": "KolourPaint",
  "identifiers": [
    "org.kde.kolourpaint.desktop",
    "org.kde.kolourpaint",
    "kolourpaint"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {
          "label": "New",
          "shortcut": "<Ctrl>N"
        },
        {
          "label": "Open…",
          "shortcut": "<Ctrl>O"
        },
        {
          "separator": true
        },
        {
          "label": "Save",
          "shortcut": "<Ctrl>S"
        },
        {
          "label": "Save As…",
          "shortcut": "<Ctrl><Shift>S"
        },
        {
          "label": "Reload",
          "shortcut": "F5"
        },
        {
          "separator": true
        },
        {
          "label": "Print…",
          "shortcut": "<Ctrl>P"
        },
        {
          "separator": true
        },
        {
          "label": "Close",
          "shortcut": "<Ctrl>W"
        },
        {
          "label": "Quit",
          "shortcut": "<Ctrl>Q"
        }
      ]
    },
    {
      "label": "Edit",
      "items": [
        {
          "label": "Undo",
          "shortcut": "<Ctrl>Z"
        },
        {
          "label": "Redo",
          "shortcut": "<Ctrl><Shift>Z"
        },
        {
          "separator": true
        },
        {
          "label": "Cut",
          "shortcut": "<Ctrl>X"
        },
        {
          "label": "Copy",
          "shortcut": "<Ctrl>C"
        },
        {
          "label": "Paste",
          "shortcut": "<Ctrl>V"
        },
        {
          "label": "Paste in New Window",
          "shortcut": "<Ctrl><Shift>V"
        },
        {
          "separator": true
        },
        {
          "label": "Select All",
          "shortcut": "<Ctrl>A"
        },
        {
          "label": "Deselect",
          "shortcut": "<Ctrl><Shift>A"
        }
      ]
    },
    {
      "label": "View",
      "items": [
        {
          "label": "Zoom to Actual Size",
          "shortcut": "<Ctrl>0"
        },
        {
          "label": "Zoom Out",
          "shortcut": "<Ctrl>minus"
        },
        {
          "label": "Zoom In",
          "shortcut": "<Ctrl>plus"
