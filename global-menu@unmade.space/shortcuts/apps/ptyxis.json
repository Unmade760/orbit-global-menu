        {"label": "Close Other Tabs"},
        {"label": "Undo Close Tab", "shortcut": "<Ctrl><Shift><Alt>T"},
        {"label": "Move Tab to New Window"},
        {"separator": true},
        {"label": "Move to Previous Tab", "shortcut": "<Ctrl>Page_Up"},
        {"label": "Move to Next Tab", "shortcut": "<Ctrl>Page_Down"},
        {"label": "Move Tab Left", "shortcut": "<Ctrl><Shift>Page_Up"},
        {"label": "Move Tab Right", "shortcut": "<Ctrl><Shift>Page_Down"},
        {"separator": true},
        {"label": "Switch to Tab 1", "shortcut": "<Alt>1"},
        {"label": "Switch to Tab 2", "shortcut": "<Alt>2"},
        {"label": "Switch to Tab 3", "shortcut": "<Alt>3"},
        {"label": "Switch to Tab 4", "shortcut": "<Alt>4"},
        {"label": "Switch to Tab 5", "shortcut": "<Alt>5"},
        {"label": "Switch to Tab 6", "shortcut": "<Alt>6"},
        {"label": "Switch to Tab 7", "shortcut": "<Alt>7"},
        {"label": "Switch to Tab 8", "shortcut": "<Alt>8"},
        {"label": "Switch to Tab 9", "shortcut": "<Alt>9"},
        {"label": "Switch to Tab 10", "shortcut": "<Alt>0"},
        {"label": "Switch to Last Tab"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Zoom In", "shortcut": "<Ctrl>plus"},
        {"label": "Zoom Out", "shortcut": "<Ctrl>minus"},
        {"label": "Reset Zoom", "shortcut": "<Ctrl>0"},
        {"separator": true},
        {"label": "Toggle Fullscreen", "shortcut": "F11"},
        {"separator": true},
        {"label": "Show Primary Menu", "shortcut": "F10"},
        {"label": "Show Context Menu", "shortcut": "<Shift>F10"},
        {"label": "Show New Tab Menu", "shortcut": "<Alt>,"}
