{
  "format": 1,
  "app": "ptyxis",
  "name": "Terminal (Ptyxis)",
  "identifiers": [
    "org.gnome.Ptyxis.desktop",
    "org.gnome.Ptyxis",
    "ptyxis"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Window", "shortcut": "<Ctrl><Shift>N"},
        {"label": "Close Window", "shortcut": "<Ctrl><Shift>Q"},
        {"label": "Set Title"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Copy to Clipboard", "shortcut": "<Ctrl><Shift>C"},
        {"label": "Paste from Clipboard", "shortcut": "<Ctrl><Shift>V"},
        {"label": "Select All", "shortcut": "<Ctrl><Shift>A"},
        {"separator": true},
        {"label": "Clear Selection"},
        {"label": "Reset"},
        {"label": "Reset and Clear"},
        {"separator": true},
        {"label": "Search History", "shortcut": "<Ctrl><Shift>F"},
        {"separator": true},
        {"label": "Preferences", "shortcut": "<Ctrl>,"}
      ]
    },
    {
      "label": "Tabs",
      "items": [
        {"label": "New Tab", "shortcut": "<Ctrl><Shift>T"},
        {"label": "View Tab Overview", "shortcut": "<Ctrl><Shift>O"},
