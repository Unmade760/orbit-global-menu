{
  "format": 1,
  "app": "drift",
  "name": "Drift",
  "identifiers": [
    "org.cutwire.Drift.desktop",
    "org.cutwire.Drift",
    "drift",
    "CutWire Drift"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {
          "label": "New Project",
          "shortcut": "<Ctrl>N"
        },
        {
          "label": "Open Project",
          "shortcut": "<Ctrl>O"
        },
        {
          "label": "Save Project",
          "shortcut": "<Ctrl>S"
        },
        {
          "label": "Save Project As…",
          "shortcut": "<Ctrl><Alt>S"
        }
      ]
    },
    {
