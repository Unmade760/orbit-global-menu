      "items": [
        {
          "label": "Undo",
          "shortcut": "<Ctrl>Z"
        },
        {
          "label": "Redo",
          "shortcut": "<Ctrl><Shift>Z"
        },
        {
          "separator": true
        },
        {
          "label": "Cut Selection",
          "shortcut": "<Ctrl>X"
        },
        {
          "label": "Copy Selection",
          "shortcut": "<Ctrl>C"
