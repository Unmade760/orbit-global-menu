        {
          "separator": true
        },
        {
          "label": "Toggle Guides",
          "shortcut": "g"
        },
        {
          "label": "3D Gizmo: Move",
          "shortcut": "t"
        },
        {
          "label": "3D Gizmo: Rotate",
          "shortcut": "r"
        },
        {
          "label": "3D Gizmo: Scale",
          "shortcut": "e"
        },
        {
          "label": "3D Gizmo: Switch Global/Local Axes",
          "shortcut": "<Shift>T"
