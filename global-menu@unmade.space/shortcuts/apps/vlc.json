        {"label": "Toggle Wallpaper Mode", "shortcut": "W"},
        {"separator": true},
        {"label": "Zoom", "items": [
          {"label": "1:4 Quarter", "shortcut": "<Alt>1"},
          {"label": "1:2 Half", "shortcut": "<Alt>2"},
          {"label": "1:1 Original", "shortcut": "<Alt>3"},
          {"label": "2:1 Double", "shortcut": "<Alt>4"},
          {"separator": true},
          {"label": "Zoom", "shortcut": "Z"},
          {"label": "Un-Zoom", "shortcut": "<Shift>Z"},
          {"label": "Increase Scale Factor", "shortcut": "<Alt>O"},
          {"label": "Decrease Scale Factor", "shortcut": "<Alt><Shift>O"}
