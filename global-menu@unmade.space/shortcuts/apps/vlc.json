          {"label": "Crop One Pixel from the Right", "shortcut": "<Alt>F"},
          {"label": "Uncrop One Pixel from the Right", "shortcut": "<Alt><Shift>F"}
        ]},
        {"label": "Deinterlace", "items": [
          {"label": "Toggle Deinterlacing", "shortcut": "D"},
          {"label": "Cycle Deinterlace Modes", "shortcut": "<Shift>D"}
        ]},
        {"separator": true},
        {"label": "Take Snapshot", "shortcut": "<Shift>S"},
        {"separator": true},
        {"label": "Shrink the Viewpoint Field of View (360°)", "shortcut": "Page_Up"},
        {"label": "Expand the Viewpoint Field of View (360°)", "shortcut": "Page_Down"}
      ]
    },
    {
      "label": "Subtitle",
      "items": [
        {"label": "Add Subtitle File…"},
        {"separator": true},
        {"label": "Cycle Subtitle Track", "shortcut": "V"},
        {"label": "Cycle Subtitle Track in Reverse Order", "shortcut": "<Alt>V"},
        {"label": "Toggle Subtitles", "shortcut": "<Shift>V"},
        {"separator": true},
        {"label": "Subtitle Delay Up", "shortcut": "H"},
        {"label": "Subtitle Delay Down", "shortcut": "G"},
        {"label": "Subtitle Sync", "items": [
          {"label": "Bookmark Audio Timestamp", "shortcut": "<Shift>H"},
          {"label": "Bookmark Subtitle Timestamp", "shortcut": "<Shift>J"},
          {"label": "Synchronize Audio and Subtitle Timestamps", "shortcut": "<Shift>K"},
          {"label": "Reset Audio and Subtitle Synchronization", "shortcut": "<Ctrl><Shift>K"}
        ]},
        {"separator": true},
        {"label": "Reset Subtitles Text Scale", "shortcut": "<Ctrl>0"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Effects and Filters", "shortcut": "<Ctrl>E"},
        {"label": "Track Synchronization"},
        {"label": "Media Information", "shortcut": "<Ctrl>I"},
        {"label": "Codec Information", "shortcut": "<Ctrl>J"},
        {"label": "VLM Configuration", "shortcut": "<Ctrl><Shift>W"},
        {"label": "Program Guide"},
        {"label": "Messages", "shortcut": "<Ctrl>M"},
        {"label": "Plugins and Extensions"},
        {"separator": true},
        {"label": "Customize Interface…"},
        {"label": "Preferences", "shortcut": "<Ctrl>P"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Playlist", "shortcut": "<Ctrl>L"},
        {"separator": true},
        {"label": "Minimal Interface", "shortcut": "<Ctrl>H"},
        {"label": "Fullscreen Interface", "shortcut": "F11"},
        {"label": "Show Controller in Fullscreen", "shortcut": "I"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Help", "shortcut": "F1"},
        {"separator": true},
        {"label": "About", "shortcut": "<Shift>F1"}
      ]
    }
