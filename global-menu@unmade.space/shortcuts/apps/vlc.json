        {"label": "Chapter", "items": [
          {"label": "Select Previous DVD Chapter", "shortcut": "<Shift>P"},
          {"label": "Select Next DVD Chapter", "shortcut": "<Shift>N"}
        ]},
        {"label": "Go to the DVD Menu", "shortcut": "<Shift>M"},
        {"label": "Custom Bookmarks", "items": [
          {"label": "Manage", "shortcut": "<Ctrl>B"}
        ]},
        {"separator": true},
        {"label": "Speed", "items": [
          {"label": "Faster", "shortcut": "+"},
