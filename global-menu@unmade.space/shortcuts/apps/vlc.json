        {"label": "Play/Pause", "shortcut": "space"},
        {"label": "Stop", "shortcut": "S"},
        {"label": "Previous", "shortcut": "P"},
        {"label": "Next", "shortcut": "N"},
        {"label": "Record", "shortcut": "<Shift>R"},
        {"separator": true},
        {"label": "Normal/Loop/Repeat", "shortcut": "L"},
        {"label": "Random", "shortcut": "R"}
      ]
    },
