          {"label": "Normal Speed", "shortcut": "="},
          {"label": "Slower (fine)", "shortcut": "["},
          {"label": "Slower", "shortcut": "-"}
        ]},
        {"separator": true},
        {"label": "Jump Forward", "items": [
          {"label": "Very Short Forward Jump", "shortcut": "<Shift>Right"},
          {"label": "Short Forward Jump", "shortcut": "<Alt>Right"},
          {"label": "Medium Forward Jump", "shortcut": "<Ctrl>Right"},
          {"label": "Long Forward Jump"}
        ]},
        {"label": "Jump Backward", "items": [
          {"label": "Very Short Backward Jump", "shortcut": "<Shift>Left"},
