        {"label": "Show History", "shortcut": "<Ctrl>H"},
        {"separator": true},
        {"label": "Configure Keyboard Shortcuts…", "shortcut": "<Ctrl><Alt>comma"},
        {"label": "Configure KCalc…", "shortcut": "<Ctrl><Shift>comma"}
      ]
