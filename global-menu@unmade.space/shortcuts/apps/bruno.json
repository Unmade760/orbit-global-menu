{
  "format": 1,
  "app": "bruno",
  "name": "Bruno",
  "identifiers": [
    "com.usebruno.Bruno.desktop",
    "com.usebruno.Bruno",
    "bruno",
    "Bruno"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {
          "label": "Save",
          "shortcut": "<Ctrl>S"
