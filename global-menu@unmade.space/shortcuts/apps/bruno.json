        {
          "separator": true
        },
        {
          "label": "Cut",
          "shortcut": "<Ctrl>X"
        },
        {
          "label": "Copy",
          "shortcut": "<Ctrl>C"
        },
        {
          "label": "Paste",
          "shortcut": "<Ctrl>V"
        },
        {
          "separator": true
        },
        {
          "label": "Select All",
          "shortcut": "<Ctrl>A"
