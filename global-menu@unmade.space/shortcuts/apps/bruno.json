        {
          "label": "Close Tab",
          "shortcut": "<Ctrl>W"
        },
        {
          "separator": true
        },
        {
          "label": "Close Bruno",
          "shortcut": "<Ctrl><Shift>Q"
        }
      ]
    },
    {
      "label": "Edit",
      "items": [
        {
          "label": "Undo",
          "shortcut": "<Ctrl>Z"
        },
        {
          "label": "Redo",
          "shortcut": "<Ctrl>Y"
