{
  "format": 1,
  "app": "papers",
  "name": "Document Viewer (Papers)",
  "identifiers": [
    "org.gnome.Papers.desktop",
    "org.gnome.Papers",
    "papers"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "Open Document", "shortcut": "<Ctrl>O"},
        {"label": "Open Copy of Current Document", "shortcut": "<Ctrl><Shift>N"},
        {"label": "Open With...", "shortcut": "<Ctrl><Shift>O"},
        {"separator": true},
        {"label": "Save Copy of Current Document", "shortcut": "<Ctrl>S"},
        {"label": "Print Current Document", "shortcut": "<Ctrl>P"},
        {"separator": true},
        {"label": "New Window", "shortcut": "<Ctrl>N"},
        {"label": "Close Current Document Window", "shortcut": "<Ctrl>W"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"separator": true},
        {"label": "Find", "shortcut": "<Ctrl>F"},
        {"label": "Find Next", "shortcut": "<Ctrl>G"},
        {"label": "Find Previous", "shortcut": "<Ctrl><Shift>G"},
        {"separator": true},
        {"label": "Add Text Annotation", "shortcut": "S"},
        {"label": "Highlight Text", "shortcut": "H"},
        {"label": "Strikethrough Text", "shortcut": "K"},
        {"label": "Wavy/Squiggly Underline Text", "shortcut": "Q"},
        {"label": "Underline Text", "shortcut": "U"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Fullscreen", "shortcut": "F11"},
        {"label": "Enter Presentation Mode", "shortcut": "F5"},
        {"label": "Side Pane", "shortcut": "F9"},
        {"label": "Caret Navigation", "shortcut": "F7"},
        {"separator": true},
        {"label": "Zoom In", "shortcut": "<Ctrl>plus"},
        {"label": "Zoom In (=)", "shortcut": "<Ctrl>="},
        {"label": "Zoom Out", "shortcut": "<Ctrl>minus"},
        {"label": "Normal Size", "shortcut": "<Ctrl>0"},
        {"separator": true},
        {"label": "Fit Page", "shortcut": "F"},
        {"label": "Fit Width", "shortcut": "W"},
        {"label": "Automatic Zoom", "shortcut": "A"},
        {"separator": true},
        {"label": "Night Mode", "shortcut": "<Ctrl>I"},
        {"label": "Continuous Scrolling", "shortcut": "C"},
        {"label": "Dual Page", "shortcut": "D"},
        {"label": "Odd Pages Left", "shortcut": "O"},
        {"separator": true},
        {"label": "Black Screen", "shortcut": "B"},
        {"label": "White Screen", "shortcut": "W"}
      ]
    },
    {
      "label": "Go",
      "items": [
        {"label": "Rotate Page Counter-Clockwise", "shortcut": "<Ctrl>Left"},
        {"label": "Rotate Page Clockwise", "shortcut": "<Ctrl>Right"},
        {"separator": true},
        {"label": "Scroll Up", "shortcut": "Page_Up"},
        {"label": "Scroll Down", "shortcut": "Page_Down"},
        {"label": "Previous Page", "shortcut": "<Ctrl>Page_Up"},
        {"label": "Next Page", "shortcut": "<Ctrl>Page_Down"},
        {"label": "Previous Page (Fast)", "shortcut": "<Shift>Page_Up"},
        {"label": "Next Page (Fast)", "shortcut": "<Shift>Page_Down"},
        {"separator": true},
        {"label": "Previous Visited Page", "shortcut": "<Alt>P"},
        {"label": "Next Visited Page", "shortcut": "<Alt>N"},
        {"separator": true},
        {"label": "Go to Page Beginning", "shortcut": "Home"},
        {"label": "Go to Page End", "shortcut": "End"},
        {"label": "Go to Document Start", "shortcut": "<Ctrl>Home"},
        {"label": "Go to Document End", "shortcut": "<Ctrl>End"},
        {"label": "Go to Page Number", "shortcut": "<Ctrl>L"}
      ]
    },
    {
      "label": "Bookmarks",
      "items": [
        {"label": "Add Bookmark", "shortcut": "<Ctrl>D"},
        {"label": "Remove Bookmark", "shortcut": "<Ctrl><Shift>D"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Help", "shortcut": "F1"},
        {"label": "Menu", "shortcut": "F10"},
        {"label": "Keyboard Shortcuts", "shortcut": "<Ctrl>question"},
        {"separator": true},
        {"label": "Document Properties", "shortcut": "<Alt>Return"}
      ]
    }
  ]
}
