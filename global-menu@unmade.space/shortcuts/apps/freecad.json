{
  "format": 1,
  "app": "freecad",
  "name": "FreeCAD",
  "identifiers": [
    "org.freecad.FreeCAD.desktop",
    "freecad.desktop",
    "freecad",
    "FreeCAD"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Document", "shortcut": "<Ctrl>N"},
        {"label": "Open Document", "shortcut": "<Ctrl>O"},
        {"label": "Save Document", "shortcut": "<Ctrl>S"},
        {"label": "Save Document As", "shortcut": "<Ctrl><Shift>S"},
        {"label": "Save All Documents", "shortcut": "<Ctrl><Shift>A"},
        {"label": "Close Document", "shortcut": "<Ctrl>F4"},
        {"label": "Close All Documents", "shortcut": "<Ctrl><Shift>W"},
        {"label": "Print Document", "shortcut": "<Ctrl>P"},
        {"label": "Print Preview"},
        {"label": "Export", "shortcut": "<Ctrl>E"},
        {"label": "Import", "shortcut": "<Ctrl>I"},
        {"label": "Quit FreeCAD", "shortcut": "<Ctrl>Q"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl>Y"},
        {"label": "Cut", "shortcut": "<Ctrl>X"},
        {"label": "Copy", "shortcut": "<Ctrl>C"},
        {"label": "Paste", "shortcut": "<Ctrl>V"},
        {"label": "Duplicate Selection", "shortcut": "<Ctrl>D"},
        {"label": "Delete", "shortcut": "Delete"},
        {"label": "Select All", "shortcut": "<Ctrl>A"},
        {"label": "Preferences", "shortcut": "<Ctrl>,"}
      ]
    },
    {
      "label": "View",
      "items": [
        {"label": "Fit All (Zoom to Fit)", "shortcut": "<Ctrl>0"},
        {"label": "Isometric View", "shortcut": "0"},
        {"label": "Front View", "shortcut": "1"},
        {"label": "Top View", "shortcut": "2"},
        {"label": "Right View", "shortcut": "3"},
        {"label": "Rear View", "shortcut": "4"},
        {"label": "Bottom View", "shortcut": "5"},
        {"label": "Left View", "shortcut": "6"},
        {"label": "Toggle Fullscreen", "shortcut": "F11"},
        {"label": "Toggle Axis Cross", "shortcut": "A C"},
        {"label": "Toggle Object Visibility", "shortcut": "space"},
        {"label": "Refresh / Recompute Document", "shortcut": "F5"}
      ]
    },
    {
      "label": "Draw",
      "items": [
        {"label": "Draw Style Flat Lines", "shortcut": "V 7"},
        {"label": "Draw Style Shaded", "shortcut": "V 6"},
        {"label": "Draw Style Wireframe", "shortcut": "V 3"}
      ]
    },
    {
      "label": "Tools",
      "items": [
        {"label": "Box Selection", "shortcut": "<Shift>B"},
        {"label": "Fit Selection", "shortcut": "V S"},
        {"label": "Python Console", "shortcut": "<Ctrl><Shift>P"}
      ]
    },
    {
      "label": "Window",
      "items": [
        {"label": "Next Document / Window", "shortcut": "<Ctrl>Tab"},
        {"label": "Previous Document / Window", "shortcut": "<Ctrl><Shift>Tab"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Help Contents", "shortcut": "F1"},
        {"label": "What's This?", "shortcut": "<Shift>F1"}
      ]
    }
  ]
}
