        {
          "label": "Reread Track Names",
          "shortcut": "<Ctrl>R"
        },
        {
          "label": "Eject Disc",
          "shortcut": "<Ctrl>J"
        },
        {
          "label": "Open MusicBrainz",
          "shortcut": "<Ctrl>S"
        },
        {
          "label": "Extract"
        },
        {
          "separator": true
        },
        {
          "label": "Toggle Playback",
          "shortcut": "<Ctrl>P"
        },
        {
          "label": "Next Track",
