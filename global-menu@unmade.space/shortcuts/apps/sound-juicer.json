{
  "format": 1,
  "app": "sound-juicer",
  "name": "Sound Juicer",
  "identifiers": [
    "org.gnome.SoundJuicer.desktop",
    "org.gnome.SoundJuicer",
    "sound-juicer",
    "Sound Juicer"
  ],
  "menus": [
    {
      "label": "Disc",
