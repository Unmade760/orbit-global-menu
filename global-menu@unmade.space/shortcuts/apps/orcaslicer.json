        },
        {
          "label": "Bottom",
          "shortcut": "<Ctrl>2"
        },
        {
          "label": "Front",
          "shortcut": "<Ctrl>3"
        },
        {
          "label": "Rear",
          "shortcut": "<Ctrl>4"
        },
        {
          "label": "Left",
          "shortcut": "<Ctrl>5"
        },
        {
          "label": "Right",
          "shortcut": "<Ctrl>6"
