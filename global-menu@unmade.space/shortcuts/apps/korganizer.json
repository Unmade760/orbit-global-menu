{
  "format": 1,
  "app": "korganizer",
  "name": "KOrganizer",
  "identifiers": [
    "org.kde.korganizer.desktop",
    "org.kde.korganizer",
    "korganizer",
    "KOrganizer"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {
          "label": "Open…",
          "shortcut": "<Ctrl>O"
        },
        {
          "label": "Print…",
          "shortcut": "<Ctrl>P"
        },
        {
          "separator": true
        },
        {
          "label": "Quit",
          "shortcut": "<Ctrl>Q"
        }
      ]
    },
    {
      "label": "Edit",
      "items": [
        {
          "label": "Undo",
