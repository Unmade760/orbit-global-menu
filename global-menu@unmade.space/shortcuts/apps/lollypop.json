        {
          "label": "Skip Forward in Track",
          "shortcut": "Right"
        },
        {
          "separator": true
        },
        {
          "label": "Volume Up",
          "shortcut": "<Shift><Alt>Up"
        },
        {
          "label": "Volume Down",
          "shortcut": "<Shift><Alt>Down"
        },
        {
          "separator": true
        },
        {
          "label": "Love Current Track",
          "shortcut": "<Alt>L"
        },
        {
          "label": "Party Mode",
          "shortcut": "<Ctrl>P"
        },
        {
          "label": "Enable/Disable Scrobbling",
          "shortcut": "<Ctrl><Shift>S"
        }
      ]
    },
    {
      "label": "Help",
      "items": [
        {
          "label": "Help",
          "shortcut": "F1"
        },
        {
          "label": "Keyboard Shortcuts",
          "shortcut": "F2"
        },
        {
          "label": "About Lollypop",
          "shortcut": "F3"
        }
      ]
    }
