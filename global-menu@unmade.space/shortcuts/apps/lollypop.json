{
  "format": 1,
  "app": "lollypop",
  "name": "Lollypop",
  "identifiers": [
    "org.gnome.Lollypop.desktop",
    "org.gnome.Lollypop",
    "lollypop"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {
          "label": "Update Music",
          "shortcut": "<Ctrl>U"
        },
        {
          "separator": true
        },
        {
          "label": "Quit",
          "shortcut": "<Ctrl>Q"
        }
      ]
    },
    {
      "label": "Edit",
      "items": [
        {
          "label": "Preferences",
          "shortcut": "<Ctrl>comma"
        },
        {
          "label": "Search",
          "shortcut": "<Ctrl>F"
        }
      ]
    },
    {
      "label": "View",
      "items": [
        {
          "label": "Show/Hide Filter",
          "shortcut": "<Ctrl>I"
        },
        {
          "label": "Show Equalizer",
          "shortcut": "<Shift><Alt>E"
        },
        {
          "label": "Show Lyrics",
          "shortcut": "<Shift><Alt>L"
        },
        {
          "label": "Lock Playback",
          "shortcut": "<Ctrl>L"
        },
        {
          "separator": true
        },
        {
          "label": "Mini Player",
          "shortcut": "<Shift><Alt>M"
        },
        {
          "label": "Fullscreen",
          "shortcut": "F11"
        }
      ]
    },
    {
      "label": "Playback",
      "items": [
        {
          "label": "Play",
          "shortcut": "X"
        },
        {
          "label": "Pause",
          "shortcut": "C"
        },
        {
          "label": "Stop",
          "shortcut": "V"
        },
        {
          "label": "Next Track",
          "shortcut": "N"
        },
        {
          "label": "Previous Track",
          "shortcut": "P"
