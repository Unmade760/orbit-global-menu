        {
          "label": "Add Folder to Playlist",
          "shortcut": "<Ctrl><Shift>I"
        },
        {
          "label": "Add URL to Playlist",
          "shortcut": "<Ctrl><Shift>U"
        },
        {
          "label": "Playlist",
          "shortcut": "<Ctrl>P"
        },
        {
          "label": "Search Playlist",
          "shortcut": "<Ctrl>F"
        },
        {
