          "shortcut": "<Ctrl>question"
        },
        {
          "label": "Preferences",
          "shortcut": "<Ctrl>comma"
        },
        {
          "label": "Save Session",
          "shortcut": "<Ctrl><Shift>S"
        },
        {
          "label": "Save Session and Close",
          "shortcut": "<Shift>Q"
