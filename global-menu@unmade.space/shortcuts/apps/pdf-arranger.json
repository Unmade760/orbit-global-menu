{
  "format": 1,
  "app": "pdf-arranger",
  "name": "PDF Arranger",
  "identifiers": [
    "com.github.jeromerobert.pdfarranger.desktop",
    "com.github.jeromerobert.pdfarranger",
    "pdfarranger",
    "PDF Arranger"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {
          "label": "Open",
          "shortcut": "<Ctrl>O"
        },
        {
          "label": "Import",
          "shortcut": "<Ctrl>I"
        },
        {
          "label": "New Window",
          "shortcut": "<Ctrl>N"
        },
        {
          "separator": true
        },
        {
          "label": "Save",
          "shortcut": "<Ctrl>S"
        },
        {
          "label": "Save As…",
          "shortcut": "<Ctrl><Shift>S"
        },
        {
          "label": "Export",
          "items": [
            {
              "label": "Export Selection to a Single File…",
              "shortcut": "<Ctrl>E"
            },
            {
              "label": "Export All Pages to Individual Files…",
              "shortcut": "<Ctrl><Shift>E"
            }
          ]
        },
        {
          "label": "Print…",
          "shortcut": "<Ctrl>P"
        },
        {
          "separator": true
        },
        {
          "label": "Edit Properties",
          "shortcut": "<Alt>Return"
        },
        {
          "separator": true
        },
        {
          "label": "Close",
          "shortcut": "<Ctrl>W"
        },
        {
          "label": "Quit",
          "shortcut": "<Ctrl>Q"
        }
      ]
    },
    {
      "label": "Edit",
      "items": [
        {
          "label": "Undo",
          "shortcut": "<Ctrl>Z"
        },
        {
          "label": "Redo",
          "shortcut": "<Ctrl>Y"
        },
        {
          "separator": true
        },
        {
          "label": "Delete",
          "shortcut": "Delete"
        },
        {
          "label": "Cut",
          "shortcut": "<Ctrl>X"
        },
        {
          "label": "Copy",
          "shortcut": "<Ctrl>C"
        },
        {
          "label": "Paste After",
          "shortcut": "<Ctrl>V"
        },
        {
          "label": "Paste Special",
          "items": [
            {
              "label": "Paste Before",
              "shortcut": "<Ctrl><Shift>V"
            },
            {
              "label": "Paste As Overlay…",
              "shortcut": "<Ctrl><Shift>O"
            },
            {
              "label": "Paste As Underlay…",
              "shortcut": "<Ctrl><Shift>U"
            }
          ]
        },
        {
          "label": "Rotate Left",
          "shortcut": "<Ctrl>Left"
        },
        {
          "label": "Rotate Right",
          "shortcut": "<Ctrl>Right"
        }
      ]
    },
    {
      "label": "Select",
      "items": [
        {
          "label": "Select All",
          "shortcut": "<Ctrl>A"
        },
        {
          "label": "Deselect All",
          "shortcut": "<Ctrl><Shift>A"
        }
      ]
    },
    {
      "label": "View",
      "items": [
        {
          "label": "Zoom In",
          "shortcut": "<Ctrl>plus"
        },
        {
          "label": "Zoom Out",
          "shortcut": "<Ctrl>minus"
        },
        {
          "label": "Fullscreen",
          "shortcut": "F11"
        }
      ]
    },
    {
      "label": "Find",
      "items": [
        {
          "label": "Find…",
          "shortcut": "<Ctrl>F"
        },
        {
          "label": "Find Previous",
          "shortcut": "<Shift>F3"
        },
        {
          "label": "Find Next",
          "shortcut": "F3"
        }
      ]
    }
  ]
}
