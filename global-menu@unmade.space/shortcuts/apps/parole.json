{
  "format": 1,
  "app": "parole",
  "name": "Parole Media Player",
  "identifiers": [
    "org.xfce.Parole.desktop",
    "org.xfce.Parole",
    "parole",
    "Parole Media Player"
  ],
  "menus": [
    {
      "label": "Media",
      "items": [
        {"label": "Open…", "shortcut": "<Ctrl>O"},
        {"label": "Open Location…", "shortcut": "<Ctrl>L"},
