    },
    {
      "label": "DVD",
      "items": [
        {"label": "DVD Menu"},
        {"label": "Title Menu"},
        {"label": "Subpicture Menu"},
        {"label": "Audio Menu"},
        {"label": "Angle Menu"},
        {"label": "Chapters", "items": [
          {"label": "Chapter Menu"}
        ]}
      ]
    },
