        {"label": "First Page", "shortcut": "<Ctrl>Home"},
        {"label": "Last Page", "shortcut": "<Ctrl>End"},
        {"separator": true},
        {"label": "Go to Page Number", "shortcut": "<Ctrl>L"}
      ]
    },
    {
      "label": "Bookmarks",
      "items": [
        {"label": "Add Bookmark", "shortcut": "<Ctrl>D"}
      ]
    },
    {
      "label": "Help",
      "items": [
        {"label": "Contents", "shortcut": "F1"}
      ]
    }
